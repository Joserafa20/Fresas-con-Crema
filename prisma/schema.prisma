generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  seller
  delivery
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(seller)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
